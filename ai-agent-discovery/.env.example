# Copy to .env and adjust for your machine.

# Base URL of the local Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# Chat/generation model (ollama pull llama3.2)
MODEL_NAME=llama3.2

# Dedicated embedding model (ollama pull nomic-embed-text).
# Changing this invalidates an existing index — re-run seed.py afterwards.
EMBEDDING_MODEL=nomic-embed-text

# Where the FAISS index is persisted (relative paths resolve to the repo root)
FAISS_DIR=data/faiss_index

# Web server bind address and port
HOST=127.0.0.1
PORT=5000

# Enable the Werkzeug debugger. NEVER turn this on for anything reachable by
# others: its interactive console can execute arbitrary code.
FLASK_DEBUG=false

# AI overviews: a local chat model summarizes why results match a query.
# Requires MODEL_NAME to be pulled. Search works fine with this off.
ENABLE_SUMMARY=true
SUMMARY_MAX_RESULTS=5
SUMMARY_TIMEOUT=30

# Requests at or above this many milliseconds are logged as slow
SLOW_REQUEST_MS=1000

# Per-client requests per minute for /api/search. 0 disables the limit.
# Summaries are capped lower because each costs a text generation.
RATE_LIMIT_SEARCHES=60
RATE_LIMIT_SUMMARIES=20

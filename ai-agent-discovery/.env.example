# Copy to .env and adjust for your machine.

# Base URL of the local Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# Chat/generation model (ollama pull llama3.2)
MODEL_NAME=llama3.2

# Dedicated embedding model (ollama pull nomic-embed-text).
# Changing this invalidates an existing index — re-run seed.py afterwards.
EMBEDDING_MODEL=nomic-embed-text

# Where the FAISS index is persisted (relative paths resolve to the repo root)
FAISS_DIR=data/faiss_index

# Copy to .env and adjust for your machine. Every value below is a default —
# the app runs with an empty .env.

# --- Ollama ---------------------------------------------------------------
# Base URL of the local Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# Chat/generation model, used for the optional AI overview (ollama pull llama3.2)
MODEL_NAME=llama3.2

# Dedicated embedding model (ollama pull nomic-embed-text).
# Changing this invalidates an existing index — re-run seed.py afterwards.
EMBEDDING_MODEL=nomic-embed-text

# --- Paths ----------------------------------------------------------------
# Relative paths resolve against the repo root, not the working directory.
DATA_DIR=data
FAISS_DIR=data/faiss_index
AGENTS_JSON=data/agents.json

# --- Search ---------------------------------------------------------------
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=50
MAX_QUERY_LENGTH=500

# Below this cosine score, results are flagged as weak rather than hidden.
# Measured on this catalogue: real queries score 0.63-0.85, nonsense 0.27-0.42.
SEARCH_MIN_SCORE=0.5

# Recent search results held in memory. 0 disables.
SEARCH_CACHE_SIZE=128

# Query embeddings persisted to disk between runs. ~91% of an uncached search
# is the round trip to Ollama, and an embedding stays valid across re-seeds.
EMBEDDING_CACHE_SIZE=500
EMBEDDING_CACHE_PATH=data/embedding_cache.json

# --- Listing and comparison -----------------------------------------------
AGENTS_PAGE_SIZE=50
AGENTS_MAX_PAGE_SIZE=200
COMPARE_MAX_AGENTS=4

# --- AI overviews ---------------------------------------------------------
# Optional; search works without a chat model pulled.
ENABLE_SUMMARY=true
SUMMARY_MAX_RESULTS=5
SUMMARY_MAX_TOKENS=220
SUMMARY_TIMEOUT=30
SUMMARY_TEMPERATURE=0.2

# --- Catalogue editing ----------------------------------------------------
# The only write surface in the app, and it has no authentication. Leave off
# unless you are on localhost and want the /admin editor.
ENABLE_ADMIN=false

# --- Server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=5000

# The Werkzeug debugger allows arbitrary code execution; opt in deliberately.
FLASK_DEBUG=false

# Requests per minute per client. 0 disables.
RATE_LIMIT_SEARCHES=60
RATE_LIMIT_SUMMARIES=20

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO

# text (human-readable) or json (one object per line, for log collectors)
LOG_FORMAT=text

# Requests at or above this many milliseconds are logged as slow.
SLOW_REQUEST_MS=1000

# Append-only record of catalogue edits made through /admin
AUDIT_LOG_PATH=data/catalogue_audit.jsonl

# Similarity above which a new agent is flagged as a possible duplicate
DUPLICATE_SCORE=0.75

# Proposal queue. Safe to leave on: nothing reaches the catalogue until a
# maintainer approves it through the admin API.
ENABLE_SUBMISSIONS=true
SUBMISSIONS_PATH=data/submissions.jsonl
RATE_LIMIT_SUBMISSIONS=10
